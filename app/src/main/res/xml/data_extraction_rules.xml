<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="obragastos.db" />
        <!-- As fotos do livro de obra, já reduzidas (uns 250 KB cada). -->
        <include domain="file" path="fotos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="obragastos.db" />
        <include domain="file" path="fotos/" />
    </device-transfer>
</data-extraction-rules>
